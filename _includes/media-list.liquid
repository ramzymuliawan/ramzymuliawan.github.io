{%- comment -%}
  Renders one list of media items.
  include.items: array from _data/media.yml; include.embed: true to show players.
{%- endcomment -%}
<ul class="list-unstyled media-list{% if include.embed %} talk-list{% endif %}">
  {% for item in include.items %}
    {% assign has_video = false %}
    {% if include.embed and item.embed %}{% assign has_video = true %}{% endif %}
    <li class="mb-4{% if include.embed %} talk-row{% endif %}">
      <div class="talk-text">
        <div class="small text-muted">
          {% if item.date %}{{ item.date }} · {% endif -%}
          {{- item.outlet -}}
          {%- if item.lang == 'id' %} · in Indonesian{% elsif item.lang == 'it' %} · in Italian{% endif %}
        </div>
        <div>
          <a
            class="item-title"
            href="{{ item.url }}"
            {% if item.lang %}
              lang="{{ item.lang }}"
            {% endif %}
          >
            {{- item.title -}}
          </a>
          {% if item.archive -%}
            <a class="archive-link" href="{{ item.archive }}"
              >(Internet Archive version{% if item.archive_note %}, {{ item.archive_note }}{% endif %})</a
            >
          {%- endif %}
        </div>
        {% if item.note %}
          <div class="small">{{ item.note }}</div>
        {% endif %}
        {% if item.links %}
          <div class="small">
            {% for l in item.links -%}
              <a href="{{ l.url }}">{{ l.label }}</a>
              {%- if l.archive %}
                <a class="archive-link" href="{{ l.archive }}">(Internet Archive version)</a>
              {%- endif -%}
              {%- unless forloop.last %} · {% endunless -%}
            {%- endfor %}
          </div>
        {% endif %}
      </div>
      {% if has_video %}
        <div class="video-embed">
          <iframe
            src="{{ item.embed }}"
            title="Video: {{ item.title | escape }}"
            loading="lazy"
            allow="encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
          ></iframe>
        </div>
      {% elsif include.embed and item.cover %}
        <figure class="slide-cover">
          <img src="{{ item.cover | relative_url }}" alt="First slide of the deck: {{ item.title | escape }}" loading="lazy">
        </figure>
      {% endif %}
    </li>
  {% endfor %}
</ul>
