{%- comment -%}
  Renders one list of media items.
  include.items: array from _data/media.yml; include.embed: true to show players.
{%- endcomment -%}
<ul class="list-unstyled media-list">
  {% for item in include.items %}
    <li class="mb-4">
      <div class="small text-muted">
        {% if item.date %}{{ item.date }} · {% endif %}{{ item.outlet }}{% if item.lang == "id" %} · in Indonesian{% elsif item.lang == "it" %} · in Italian{% endif %}
      </div>
      <div><a href="{{ item.url }}"{% if item.lang %} lang="{{ item.lang }}"{% endif %}>{{ item.title }}</a></div>
      {% if item.note %}<div class="small">{{ item.note }}</div>{% endif %}
      {% if item.links %}
        <div class="small">
          {% for l in item.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% unless forloop.last %} · {% endunless %}{% endfor %}
        </div>
      {% endif %}
      {% if include.embed and item.embed %}
        <div class="video-embed">
          <iframe
            src="{{ item.embed }}"
            title="Video: {{ item.title | escape }}"
            loading="lazy"
            allow="encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
          ></iframe>
        </div>
      {% endif %}
    </li>
  {% endfor %}
</ul>
